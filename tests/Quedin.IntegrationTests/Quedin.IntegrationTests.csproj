<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests: run the real data layer (Entity Framework + business services)
    against QuedinDB on SQL Server LocalDB. Create the database first with
    database/create-database.sql. Each test is rolled back.
    If the database is missing, the tests are reported as inconclusive.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Quedin.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LawyerProject\LawyerProject.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Transactions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
  </ItemGroup>

</Project>
